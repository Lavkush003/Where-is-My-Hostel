{
  "name": "where-is-my-hostel-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for Where Is My Hostel.",
  "scripts": {
    "dev": "node scripts/run-tailwind.js -i ./src/input.css -o ../Backend/static/css/tailwind.css --watch",
    "build": "node scripts/run-tailwind.js -i ./src/input.css -o ../Backend/static/css/tailwind.css --minify",
    "build:dev": "node scripts/run-tailwind.js -i ./src/input.css -o ../Backend/static/css/tailwind.css"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
