# Copy this file to .env inside Backend/ and fill in your values.
# Never commit the real .env file.

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database
# Use "sqlite" for local development or "postgresql" for production-like setups.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL settings required when DB_ENGINE=postgresql
# DB_NAME=where_is_my_hostel
# DB_USER=postgres
# DB_PASSWORD=replace-with-your-password
# DB_HOST=localhost
# DB_PORT=5432

# Optional public contact address shown on the contact page.
CONTACT_EMAIL=support@whereismyhostel.com

# Email
# Development defaults to console backend. In production configure SMTP:
EMAIL_BACKEND=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@whereismyhostel.example

DJANGO_LOG_LEVEL=INFO

